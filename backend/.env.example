# ============================================================
# PWAutomations Fitness Demo - Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores
# ============================================================

# Supabase
SUPABASE_URL="https://geojajpgibeubvoghbte.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_cola_aqui"

# JWT - muda para uma string longa e aleatória em produção
JWT_SECRET="fitcoach-dev-secret-muda-isto-em-producao"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# App publica (links de check-in/feedback)
PUBLIC_APP_URL="https://pwautomations.com"

# Frontend (para CORS) - pode ser uma lista separada por virgulas
# Exemplo: "http://localhost:5173,https://pwautomations.com,https://www.pwautomations.com"
CORS_ORIGIN="http://localhost:5173,https://pwautomations.com,https://www.pwautomations.com"

# Google Sheets (importação de métricas)
# Partilha a Google Sheet com o email da service account com permissão de leitura.
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"

# Gmail OAuth (envio de emails das automações)
# Cria um OAuth Client ID (tipo "Web application") em https://console.cloud.google.com/apis/credentials
# Redirect URI a autorizar: "<PUBLIC_APP_URL>/automations"
# Nota: o ecrã de consentimento OAuth deve estar publicado em modo "Production" (não "Testing"),
# senão o refresh token expira ao fim de 7 dias e as automações agendadas falham a autenticar.
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

# Cron (endpoint /api/cron/run-automations, usado quando o scheduler chama via HTTP em vez de invocar o handler diretamente)
CRON_SECRET="REPLACE_ME"

# Armazenamento de fotos: "local" ou "s3"
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

